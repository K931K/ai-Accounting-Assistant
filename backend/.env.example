# 复制为 backend/.env 后按本机 MySQL 的实际账号修改；不配置时用下面的缺省值。
# 应用启动会自动建库建表，只需要账号有建库权限。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=ledger

# ===== 大模型接入 =====
# dify=自建 Dify（工作流 + 对话应用，支持多轮），openai=任意 OpenAI 兼容接口
AI_PROVIDER=dify

# ---- 文本模型：一句话记账与自然语言查账（openai 方式用） ----
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-flash
AI_API_KEY=
# 单次调用超时（秒）与额外重试次数（只对 429 / 5xx / 超时重试）
AI_TIMEOUT=20
AI_RETRIES=2

# ---- 视觉模型：小票与支付截图识别（openai 方式用） ----
# AI_VISION_MODEL 留空表示不启用图片识别，上传后返回空草稿由用户补全。
# DeepSeek V4.1-Flash 原生支持图片，文本与视觉可以共用同一组配置。
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=

# ===== Dify（AI_PROVIDER=dify 时生效）=====
# 服务根地址，只到主机与端口（接口路径里的 /v1 由代码拼）
DIFY_BASE_URL=
# 工作流应用密钥；三条任务可以各用一个工作流，未单独配置时回退到 DIFY_WORKFLOW_NAME
DIFY_API_KEY=
DIFY_WORKFLOW_NAME=text_extract
DIFY_WORKFLOW_TEXT=text_extract
DIFY_WORKFLOW_QUERY=query_parse
DIFY_WORKFLOW_RECEIPT=receipt_ocr
# 工作流里接收图片的变量名
DIFY_FILE_INPUT=image
# 对话型应用（chatflow / agent）密钥，用于多轮对话；不填则 /agent/chat 走本地兜底
DIFY_CHAT_API_KEY=
