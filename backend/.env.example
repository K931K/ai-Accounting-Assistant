# 复制为 backend/.env 后按本机 MySQL 的实际账号修改；不配置时用下面的缺省值。
# 应用启动会自动建库建表，只需要账号有建库权限。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=你的数据库密码
DB_NAME=ledger

# ===== 大模型接入 =====
# openai=任意 OpenAI 兼容接口（DeepSeek、通义、智谱均可），dify=自建 Dify 工作流
AI_PROVIDER=openai

# ---- 文本模型：一句话记账与自然语言查账 ----
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
# 单次调用超时（秒）与额外重试次数（只对 429 / 5xx / 超时重试）
AI_TIMEOUT=20
AI_RETRIES=2

# ---- 视觉模型：小票与支付截图识别 ----
# AI_VISION_MODEL 留空表示不启用图片识别，上传后返回空草稿由用户补全。
# 视觉模型的地址与密钥可以单独填（文本模型没有视觉能力时这样用），留空则复用上面那组。
AI_VISION_MODEL=
AI_VISION_BASE_URL=
AI_VISION_API_KEY=

# 走 Dify 时填下面两项，工作流输入变量约定为 task / system_prompt / text，输出变量 result
DIFY_BASE_URL=
DIFY_API_KEY=
DIFY_WORKFLOW_NAME=text_extract
